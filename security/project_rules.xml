<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-Company Rule for Projects -->
    <record id="project_manage_comp_rule" model="ir.rule">
        <field name="name">Project Manage Multi-Company</field>
        <field name="model_id" ref="model_project_manage"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Multi-Company Rule for Scopes/Tasks -->
    <record id="project_manage_scope_comp_rule" model="ir.rule">
        <field name="name">Project Scope Multi-Company</field>
        <field name="model_id" ref="model_project_manage_scope"/>
        <field name="domain_force">['|', ('project_id', '=', False), ('project_id.company_id', 'in', company_ids)]</field>
    </record>

    <!-- Executive & Manager Access: Admin, CEO, VP, Project Manager see all projects -->
    <record id="rule_project_manage_exec" model="ir.rule">
        <field name="name">Executive and Manager Projects Access</field>
        <field name="model_id" ref="model_project_manage"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('group_project_manage_manager')), (4, ref('group_project_manage_vp')), (4, ref('group_project_manage_ceo')), (4, ref('group_project_manage_administrator'))]"/>
    </record>

    <!-- Executive & Manager Access: Admin, CEO, VP, Project Manager see all scopes/tasks -->
    <record id="rule_project_scope_exec" model="ir.rule">
        <field name="name">Executive and Manager Scopes Access</field>
        <field name="model_id" ref="model_project_manage_scope"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('group_project_manage_manager')), (4, ref('group_project_manage_vp')), (4, ref('group_project_manage_ceo')), (4, ref('group_project_manage_administrator'))]"/>
    </record>

    <!-- Multi-Company Rule for Teams -->
    <record id="project_manage_team_comp_rule" model="ir.rule">
        <field name="name">Project Team Multi-Company</field>
        <field name="model_id" ref="model_project_manage_team"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Executive & Manager Access: Admin, CEO, VP, Project Manager see all teams -->
    <record id="rule_project_manage_team_exec" model="ir.rule">
        <field name="name">Executive and Manager Teams Access</field>
        <field name="model_id" ref="model_project_manage_team"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('group_project_manage_manager')), (4, ref('group_project_manage_vp')), (4, ref('group_project_manage_ceo')), (4, ref('group_project_manage_administrator'))]"/>
    </record>

    <!-- Team Lead: Access only their own team -->
    <record id="rule_project_manage_team_tl" model="ir.rule">
        <field name="name">Team Lead Assigned Team Access</field>
        <field name="model_id" ref="model_project_manage_team"/>
        <field name="domain_force">['|', ('team_lead_id', '=', user.id), ('member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_project_manage_team_lead'))]"/>
    </record>

    <!-- Consultant: Access only their assigned team -->
    <record id="rule_project_manage_team_consultant" model="ir.rule">
        <field name="name">Consultant Assigned Team Access</field>
        <field name="model_id" ref="model_project_manage_team"/>
        <field name="domain_force">[('member_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_project_manage_consultant'))]"/>
    </record>

    <!-- Team Lead: Access to assigned team projects only -->
    <record id="rule_project_manage_tl" model="ir.rule">
        <field name="name">Team Lead Assigned Projects</field>
        <field name="model_id" ref="model_project_manage"/>
        <field name="domain_force">['|', '|', '|',
            ('team_lead_id.user_id', '=', user.id),
            ('team_id.team_lead_id', '=', user.id),
            ('team_id.member_ids', 'in', [user.id]),
            ('consultant_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_project_manage_team_lead'))]"/>
    </record>

    <!-- Team Lead: Scopes in their projects OR unassigned scopes -->
    <record id="rule_project_scope_mgr_tl" model="ir.rule">
        <field name="name">Team Lead Scopes Access</field>
        <field name="model_id" ref="model_project_manage_scope"/>
        <field name="domain_force">['|', ('project_id', '=', False), '|', '|',
            ('project_id.team_lead_id.user_id', '=', user.id),
            ('project_id.team_id.team_lead_id', '=', user.id),
            ('responsible_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_project_manage_team_lead'))]"/>
    </record>

    <!-- Consultant: Read-only access to assigned projects -->
    <record id="rule_project_manage_consultant" model="ir.rule">
        <field name="name">Consultant Assigned Projects</field>
        <field name="model_id" ref="model_project_manage"/>
        <field name="domain_force">['|', '|',
            ('consultant_ids.user_id', '=', user.id),
            ('team_id.member_ids', 'in', [user.id]),
            ('scope_ids.responsible_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_project_manage_consultant'))]"/>
    </record>

    <!-- Consultant: Scopes / Tasks strictly assigned to them -->
    <record id="rule_project_scope_consultant" model="ir.rule">
        <field name="name">Consultant Assigned Tasks</field>
        <field name="model_id" ref="model_project_manage_scope"/>
        <field name="domain_force">[('responsible_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_project_manage_consultant'))]"/>
    </record>

    <!-- Multi-Company Rule for Customer Reviews -->
    <record id="project_manage_review_comp_rule" model="ir.rule">
        <field name="name">Project Review Multi-Company</field>
        <field name="model_id" ref="model_project_manage_review"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Executive & Manager Reviews Access: Admin, CEO, VP, Project Manager see all reviews -->
    <record id="rule_project_review_exec" model="ir.rule">
        <field name="name">Executive and Manager Reviews Access</field>
        <field name="model_id" ref="model_project_manage_review"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('group_project_manage_manager')), (4, ref('group_project_manage_vp')), (4, ref('group_project_manage_ceo')), (4, ref('group_project_manage_administrator'))]"/>
    </record>

    <!-- Team Lead Reviews Access: Only reviews for their team projects -->
    <record id="rule_project_review_tl" model="ir.rule">
        <field name="name">Team Lead Reviews Access</field>
        <field name="model_id" ref="model_project_manage_review"/>
        <field name="domain_force">['|', '|', '|',
            ('project_id.team_lead_id.user_id', '=', user.id),
            ('project_id.team_id.team_lead_id', '=', user.id),
            ('project_id.team_id.member_ids', 'in', [user.id]),
            ('project_id.consultant_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_project_manage_team_lead'))]"/>
    </record>

    <!-- Consultant Reviews Access: Only reviews for projects they are assigned to -->
    <record id="rule_project_review_consultant" model="ir.rule">
        <field name="name">Consultant Reviews Access</field>
        <field name="model_id" ref="model_project_manage_review"/>
        <field name="domain_force">['|', '|',
            ('project_id.consultant_ids.user_id', '=', user.id),
            ('project_id.team_id.member_ids', 'in', [user.id]),
            ('project_id.scope_ids.responsible_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_project_manage_consultant'))]"/>
    </record>
</odoo>
