<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Documentation Tasks Dedicated List View (Exact layout matching Benchmark Sheet) -->
    <record id="view_project_manage_scope_doc_list" model="ir.ui.view">
        <field name="name">project.manage.scope.doc.list</field>
        <field name="model">project.manage.scope</field>
        <field name="arch" type="xml">
            <list string="Documentation Tasks" editable="bottom" multi_edit="1">
                <field name="priority" widget="priority" optional="show" nolabel="1"/>
                <field name="can_edit_scope_fields" column_invisible="True"/>
                <field name="scope_no" string="Scope No" readonly="not can_edit_scope_fields"/>
                <field name="scope" string="Scope (Functional Area)" readonly="not can_edit_scope_fields"/>
                <field name="item_no" string="Doc No" readonly="not can_edit_scope_fields"/>
                <field name="name" string="Document Name" readonly="not can_edit_scope_fields"/>
                <field name="item_type" string="Document Type" readonly="not can_edit_scope_fields"/>
                <field name="approval_authority" string="Final Approval Authority" widget="badge" readonly="not can_edit_scope_fields"/>
                <field name="accountable_id" string="Accountable" widget="many2one_avatar_user" readonly="not can_edit_scope_fields"/>
                <field name="responsible_ids" string="Responsible" widget="many2many_tags" readonly="not can_edit_scope_fields"/>
                <field name="start_date" string="Start Date" readonly="not can_edit_scope_fields"/>
                <field name="end_date" string="End Date" readonly="not can_edit_scope_fields"/>
                <field name="approval_state" string="Approval Stage" widget="badge"
                       decoration-info="approval_state == 'pending_tl'"
                       decoration-primary="approval_state == 'pending_pm'"
                       decoration-warning="approval_state == 'pending_vp'"
                       decoration-danger="approval_state == 'pending_ceo'"
                       decoration-success="approval_state == 'approved'"/>
                <field name="state" string="Status" widget="selection" readonly="not can_edit_scope_fields"
                       decoration-info="state == 'todo'"
                       decoration-warning="state == 'in_progress'"
                       decoration-primary="state == 'under_review'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="can_user_approve" column_invisible="True"/>
                <button name="action_approve_level" string="Approve" type="object" icon="fa-check text-success"
                        invisible="not can_user_approve" class="btn-success btn-sm"/>
                <button name="action_open_reject_wizard" string="Reject" type="object" icon="fa-times text-danger"
                        invisible="not can_user_approve" class="btn-danger btn-sm"/>
                <field name="project_id" string="Project" optional="show" readonly="not can_edit_scope_fields"/>
                <field name="item_id" string="Item ID" optional="hide" readonly="not can_edit_scope_fields"/>
            </list>
        </field>
    </record>

    <!-- Implementation Tasks Dedicated List View (Exact layout matching Benchmark Sheet) -->
    <record id="view_project_manage_scope_imp_list" model="ir.ui.view">
        <field name="name">project.manage.scope.imp.list</field>
        <field name="model">project.manage.scope</field>
        <field name="arch" type="xml">
            <list string="Implementation Tasks" editable="bottom" multi_edit="1">
                <field name="priority" widget="priority" optional="show" nolabel="1"/>
                <field name="can_edit_scope_fields" column_invisible="True"/>
                <field name="item_no" string="Activity No" readonly="not can_edit_scope_fields"/>
                <field name="name" string="Implementation Activity" readonly="not can_edit_scope_fields"/>
                <field name="item_type" string="Activity Type" readonly="not can_edit_scope_fields"/>
                <field name="evidence_proof" string="Evidence / Proof" readonly="not can_edit_scope_fields"/>
                <field name="approval_authority" string="Final Approval Authority" widget="badge" readonly="not can_edit_scope_fields"/>
                <field name="accountable_id" string="Accountable" widget="many2one_avatar_user" readonly="not can_edit_scope_fields"/>
                <field name="responsible_ids" string="Responsible" widget="many2many_tags" readonly="not can_edit_scope_fields"/>
                <field name="start_date" string="Start Date" readonly="not can_edit_scope_fields"/>
                <field name="end_date" string="End Date" readonly="not can_edit_scope_fields"/>
                <field name="approval_state" string="Approval Stage" widget="badge"
                       decoration-info="approval_state == 'pending_tl'"
                       decoration-primary="approval_state == 'pending_pm'"
                       decoration-warning="approval_state == 'pending_vp'"
                       decoration-danger="approval_state == 'pending_ceo'"
                       decoration-success="approval_state == 'approved'"/>
                <field name="state" string="Status" widget="selection" readonly="not can_edit_scope_fields"
                       decoration-info="state == 'todo'"
                       decoration-warning="state == 'in_progress'"
                       decoration-primary="state == 'under_review'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="can_user_approve" column_invisible="True"/>
                <button name="action_approve_level" string="Approve" type="object" icon="fa-check text-success"
                        invisible="not can_user_approve" class="btn-success btn-sm"/>
                <button name="action_open_reject_wizard" string="Reject" type="object" icon="fa-times text-danger"
                        invisible="not can_user_approve" class="btn-danger btn-sm"/>
                <field name="scope_no" string="Scope No" optional="show" readonly="not can_edit_scope_fields"/>
                <field name="scope" string="Scope (Functional Area)" optional="show" readonly="not can_edit_scope_fields"/>
                <field name="project_id" string="Project" optional="show" readonly="not can_edit_scope_fields"/>
                <field name="item_id" string="Item ID" optional="hide" readonly="not can_edit_scope_fields"/>
            </list>
        </field>
    </record>

    <!-- General Scope List View -->
    <record id="view_project_manage_scope_list" model="ir.ui.view">
        <field name="name">project.manage.scope.list</field>
        <field name="model">project.manage.scope</field>
        <field name="arch" type="xml">
            <list string="Scopes &amp; Tasks" editable="bottom" multi_edit="1">
                <field name="priority" widget="priority" optional="show" nolabel="1"/>
                <field name="can_edit_scope_fields" column_invisible="True"/>
                <field name="scope_no" string="Scope No" optional="show" readonly="not can_edit_scope_fields"/>
                <field name="scope" string="Scope (Functional Area)" readonly="not can_edit_scope_fields"/>
                <field name="category" string="Category" readonly="not can_edit_scope_fields"/>
                <field name="item_no" string="Item / Doc / Act No" readonly="not can_edit_scope_fields"/>
                <field name="name" string="Task / Item Name" readonly="not can_edit_scope_fields"/>
                <field name="item_type" string="Type" readonly="not can_edit_scope_fields"/>
                <field name="evidence_proof" string="Evidence / Proof" optional="show" readonly="not can_edit_scope_fields"/>
                <field name="approval_authority" string="Final Approval Authority" widget="badge" optional="show" readonly="not can_edit_scope_fields"/>
                <field name="accountable_id" string="Accountable" widget="many2one_avatar_user" readonly="not can_edit_scope_fields"/>
                <field name="responsible_ids" string="Responsible" widget="many2many_tags" readonly="not can_edit_scope_fields"/>
                <field name="start_date" string="Start Date" readonly="not can_edit_scope_fields"/>
                <field name="end_date" string="End Date" readonly="not can_edit_scope_fields"/>
                <field name="approval_state" string="Approval Stage" widget="badge"
                       decoration-info="approval_state == 'pending_tl'"
                       decoration-primary="approval_state == 'pending_pm'"
                       decoration-warning="approval_state == 'pending_vp'"
                       decoration-danger="approval_state == 'pending_ceo'"
                       decoration-success="approval_state == 'approved'"/>
                <field name="state" string="Status" widget="selection" readonly="not can_edit_scope_fields"
                       decoration-info="state == 'todo'"
                       decoration-warning="state == 'in_progress'"
                       decoration-primary="state == 'under_review'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="can_user_approve" column_invisible="True"/>
                <button name="action_approve_level" string="Approve" type="object" icon="fa-check text-success"
                        invisible="not can_user_approve" class="btn-success btn-sm"/>
                <button name="action_open_reject_wizard" string="Reject" type="object" icon="fa-times text-danger"
                        invisible="not can_user_approve" class="btn-danger btn-sm"/>
                <field name="project_id" string="Project" optional="show" readonly="not can_edit_scope_fields"/>
                <field name="item_id" string="Item ID" optional="hide" readonly="not can_edit_scope_fields"/>
            </list>
        </field>
    </record>

    <!-- Scope Form View -->
    <record id="view_project_manage_scope_form" model="ir.ui.view">
        <field name="name">project.manage.scope.form</field>
        <field name="model">project.manage.scope</field>
        <field name="arch" type="xml">
            <form string="Scope / Task Item">
                <header>
                    <field name="can_current_user_complete" invisible="1"/>
                    <button name="action_start" string="Start Task" type="object" class="btn-primary"
                            invisible="state != 'todo' or not can_current_user_complete"/>
                    <button name="action_submit_for_approval" string="Submit for Approval" type="object" class="btn-warning"
                            invisible="not can_current_user_complete or approval_state in ('approved', 'pending_tl', 'pending_pm', 'pending_vp', 'pending_ceo') or state == 'done'"/>
                    <button name="action_approve_level" string="Approve" type="object" class="btn-success"
                            invisible="not can_user_approve"/>
                    <button name="action_open_reject_wizard" string="Reject / Request Re-Work" type="object" class="btn-danger"
                            invisible="not can_user_approve"/>
                    <button name="action_reset_todo" string="Reset to To Do" type="object"
                            invisible="state not in ('cancelled', 'done')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="approval_state" widget="statusbar" statusbar_visible="draft,pending_tl,pending_pm,pending_vp,pending_ceo,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="approval_state != 'rejected'">
                        <strong><i class="fa fa-exclamation-triangle me-1"></i> Re-Work Requested:</strong>
                        <field name="rejection_reason" readonly="1" class="d-inline ms-1"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-paperclip">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <field name="can_edit_scope_fields" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Document Name" invisible="category != 'Documentation'"/>
                        <label for="name" string="Implementation Activity" invisible="category == 'Documentation'"/>
                        <h1>
                            <div class="d-flex align-items-center">
                                <field name="priority" widget="priority" class="me-3"/>
                                <field name="name" placeholder="Document Name or Implementation Activity..." readonly="not can_edit_scope_fields"/>
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group string="Scope Details">
                            <field name="item_id" readonly="not can_edit_scope_fields"/>
                            <field name="scope_no" readonly="not can_edit_scope_fields"/>
                            <field name="scope" string="Scope (Functional Area)" readonly="not can_edit_scope_fields"/>
                            <field name="category" readonly="not can_edit_scope_fields"/>
                            <field name="item_no" string="Doc No" invisible="category != 'Documentation'" readonly="not can_edit_scope_fields"/>
                            <field name="item_no" string="Activity No" invisible="category == 'Documentation'" readonly="not can_edit_scope_fields"/>
                            <field name="item_type" string="Document Type" invisible="category != 'Documentation'" readonly="not can_edit_scope_fields"/>
                            <field name="item_type" string="Activity Type" invisible="category == 'Documentation'" readonly="not can_edit_scope_fields"/>
                            <field name="evidence_proof" string="Evidence / Proof" invisible="category != 'Implementation'" readonly="not can_edit_scope_fields"/>
                        </group>
                        <group string="Governance, Accountability &amp; Schedule">
                            <field name="project_id" readonly="not can_edit_scope_fields"/>
                            <field name="approval_authority" string="Final Approval Authority" readonly="not can_edit_scope_fields"/>
                            <field name="accountable_id" string="Accountable" readonly="not can_edit_scope_fields"/>
                            <field name="responsible_ids" string="Responsible" widget="many2many_tags" readonly="not can_edit_scope_fields"/>
                            <field name="start_date" string="Start Date" readonly="not can_edit_scope_fields"/>
                            <field name="end_date" string="End Date" readonly="not can_edit_scope_fields"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes &amp; Details" name="notes">
                            <field name="notes" placeholder="Notes, instructions or deliverables..."/>
                        </page>
                        <page string="Documents &amp; Files" name="documents">
                            <group string="Quick File Upload (Multiple Attachments)">
                                <field name="attachment_ids" widget="many2many_binary" string="Upload Files" nolabel="1"/>
                            </group>
                            <group string="Document &amp; Deliverable Register">
                                <field name="document_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name" string="Document Title" placeholder="e.g. Approved SOP, Audit Evidence..."/>
                                        <field name="doc_type" string="Category"/>
                                        <field name="file" filename="filename" string="File (Upload / Download)"/>
                                        <field name="filename" column_invisible="True"/>
                                        <field name="file_size_display" string="Size"/>
                                        <field name="uploaded_by" string="Uploaded By" optional="show"/>
                                        <field name="upload_date" string="Upload Date" optional="show"/>
                                        <field name="notes" string="Notes" optional="show"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Approval History &amp; Audit Trail" name="approval_history">
                            <field name="approval_log_ids" readonly="1">
                                <list decoration-success="action == 'approve'" decoration-danger="action == 'reject'" decoration-warning="action == 'submit'" decoration-info="action == 'start'">
                                    <field name="date" string="Date &amp; Time"/>
                                    <field name="user_id" string="Action By"/>
                                    <field name="role_name" string="Approver Role"/>
                                    <field name="action" string="Action" widget="badge"/>
                                    <field name="from_state" string="From Stage"/>
                                    <field name="to_state" string="To Stage"/>
                                    <field name="note" string="Comments / Feedback"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Scope Search View -->
    <record id="view_project_manage_scope_search" model="ir.ui.view">
        <field name="name">project.manage.scope.search</field>
        <field name="model">project.manage.scope</field>
        <field name="arch" type="xml">
            <search string="Search Scopes &amp; Tasks">
                <field name="name" string="Task / Document Name"/>
                <field name="id"/>
                <field name="priority"/>
                <field name="scope" string="Scope (Functional Area)"/>
                <field name="scope_no"/>
                <field name="category"/>
                <field name="item_type"/>
                <field name="project_id"/>
                <field name="accountable_id"/>
                <field name="responsible_ids" string="Responsible"/>
                <field name="responsible_id" string="Primary Responsible"/>
                <field name="approval_authority"/>
                <separator/>
                <filter name="f_starred" string="Starred / High Priority" domain="[('priority', 'in', ('2', '3'))]"/>
                <separator/>
                <filter name="f_doc" string="Documentation" domain="[('category', '=', 'Documentation')]"/>
                <filter name="f_imp" string="Implementation" domain="[('category', '=', 'Implementation')]"/>
                <separator/>
                <filter name="f_my_tasks" string="My Assigned Tasks" domain="[('is_my_task', '=', True)]"/>
                <filter name="f_can_approve" string="Waiting My Approval" domain="[('can_user_approve', '=', True)]"/>
                <separator/>
                <filter name="f_pending_tl" string="Pending Team Lead" domain="[('approval_state', '=', 'pending_tl')]"/>
                <filter name="f_pending_pm" string="Pending Project Manager" domain="[('approval_state', '=', 'pending_pm')]"/>
                <filter name="f_pending_vp" string="Pending VP" domain="[('approval_state', '=', 'pending_vp')]"/>
                <filter name="f_pending_ceo" string="Pending CEO" domain="[('approval_state', '=', 'pending_ceo')]"/>
                <filter name="f_approved" string="Approved" domain="[('approval_state', '=', 'approved')]"/>
                <filter name="f_rejected" string="Rejected / Re-Work" domain="[('approval_state', '=', 'rejected')]"/>
                <separator/>
                <filter name="f_todo" string="To Do" domain="[('state', '=', 'todo')]"/>
                <filter name="f_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="f_review" string="Under Review" domain="[('state', '=', 'under_review')]"/>
                <filter name="f_done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="f_today" string="Today" domain="[('start_date', '&lt;=', context_today().strftime('%Y-%m-%d')), ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="f_this_week" string="This Week" domain="[('end_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('start_date', '&lt;=', (context_today() + datetime.timedelta(days=6 - context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter name="f_this_month" string="This Month" domain="[('end_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <group>
                    <filter name="g_priority" string="Priority" context="{'group_by': 'priority'}"/>
                    <filter name="g_scope" string="Scope" context="{'group_by': 'scope'}"/>
                    <filter name="g_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="g_accountable" string="Accountable" context="{'group_by': 'accountable_id'}"/>
                    <filter name="g_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                    <filter name="g_start_date" string="Start Date" context="{'group_by': 'start_date'}"/>
                    <filter name="g_end_date" string="Deadline (End Date)" context="{'group_by': 'end_date'}"/>
                    <filter name="g_approver_auth" string="Final Approval Authority" context="{'group_by': 'approval_authority'}"/>
                    <filter name="g_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="g_type" string="Item Type" context="{'group_by': 'item_type'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Scope Kanban View -->
    <record id="view_project_manage_scope_kanban" model="ir.ui.view">
        <field name="name">project.manage.scope.kanban</field>
        <field name="model">project.manage.scope</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <field name="state"/>
                <field name="priority"/>
                <field name="category"/>
                <field name="scope"/>
                <field name="item_type"/>
                <field name="responsible_ids" widget="many2many_tags"/>
                <field name="responsible_id"/>
                <field name="end_date"/>
                <field name="color"/>
                <field name="document_count"/>
                <templates>
                    <t t-name="card">
                        <main>
                            <div class="d-flex flex-column gap-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge text-bg-light border text-truncate fw-normal" style="max-width: 60%;">
                                        <i class="fa fa-folder-open-o me-1" title="Scope" role="img" aria-label="Scope"/>
                                        <field name="scope"/>
                                    </span>
                                    <div class="d-flex gap-1 align-items-center">
                                        <field name="priority" widget="priority"/>
                                        <span invisible="document_count == 0" class="badge text-bg-light border text-secondary" title="Uploaded Documents">
                                            <i class="fa fa-paperclip me-1" title="Files" role="img" aria-label="Files"/>
                                            <field name="document_count"/>
                                        </span>
                                        <field name="category" widget="badge"
                                               decoration-info="category == 'Documentation'"
                                               decoration-primary="category == 'Implementation'"/>
                                    </div>
                                </div>
                                <div class="fw-bold fs-6 text-dark lh-sm">
                                    <field name="name"/>
                                </div>
                                <div class="text-muted small d-flex flex-wrap gap-1 align-items-center mt-1">
                                    <span invisible="not item_type" class="badge text-bg-secondary-subtle text-secondary border">
                                        <i class="fa fa-tag me-1" title="Type" role="img" aria-label="Type"/>
                                        <field name="item_type"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
                                    <div class="d-flex align-items-center text-truncate me-2" invisible="not responsible_ids and not responsible_id">
                                        <i class="fa fa-user-circle me-1" title="Responsible" role="img" aria-label="Responsible"/>
                                        <field name="responsible_ids" widget="many2many_tags"/>
                                    </div>
                                    <div class="d-flex align-items-center text-nowrap ms-auto" invisible="not end_date">
                                        <i class="fa fa-calendar me-1" title="Due Date" role="img" aria-label="Due Date"/>
                                        <field name="end_date"/>
                                    </div>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Scope & Task Calendar View -->
    <record id="view_project_manage_scope_calendar" model="ir.ui.view">
        <field name="name">project.manage.scope.calendar</field>
        <field name="model">project.manage.scope</field>
        <field name="arch" type="xml">
            <calendar string="Tasks Calendar"
                      date_start="start_date"
                      date_stop="end_date"
                      mode="month"
                      color="responsible_id"
                      event_limit="5"
                      hide_time="true"
                      event_open_popup="true"
                      quick_create="0"
                      scales="day,week,month,year">
                <field name="name" string="Task"/>
                <field name="project_id"/>
                <field name="responsible_id" widget="many2one_avatar" avatar_field="image_128" filters="1"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"/>
                <field name="approval_state" widget="badge"/>
                <field name="category"/>
            </calendar>
        </field>
    </record>

    <!-- Main Window Actions -->
    <record id="action_project_manage_scope" model="ir.actions.act_window">
        <field name="name">Scopes</field>
        <field name="res_model">project.manage.scope</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="view_id" ref="view_project_manage_scope_list"/>
        <field name="search_view_id" ref="view_project_manage_scope_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage all Scopes, Documentation tasks, and Implementation activities.
            </p>
        </field>
    </record>

    <!-- Dedicated Tasks Calendar Action -->
    <record id="action_project_manage_scope_calendar" model="ir.actions.act_window">
        <field name="name">Tasks Calendar</field>
        <field name="res_model">project.manage.scope</field>
        <field name="view_mode">calendar,list,kanban,form</field>
        <field name="view_id" ref="view_project_manage_scope_calendar"/>
        <field name="search_view_id" ref="view_project_manage_scope_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tasks scheduled on the calendar!
            </p>
            <p>
                Schedule and track all tasks across all users in Month, Week, and Day views.
            </p>
        </field>
    </record>

    <record id="action_project_manage_scope_calendar_view_cal" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_project_manage_scope_calendar"/>
        <field name="act_window_id" ref="action_project_manage_scope_calendar"/>
    </record>

    <record id="action_project_manage_scope_calendar_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_project_manage_scope_list"/>
        <field name="act_window_id" ref="action_project_manage_scope_calendar"/>
    </record>

    <record id="action_project_manage_scope_calendar_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_project_manage_scope_kanban"/>
