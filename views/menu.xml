<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_project_manage_root" name="Project Management"
              groups="project_manage.group_project_manage_consultant" sequence="20"/>

    <!-- Main Navigation Menus -->
    <menuitem id="menu_project_manage_dashboard" name="Dashboard"
              parent="menu_project_manage_root" action="action_project_manage_dashboard"
              groups="project_manage.group_project_manage_consultant" sequence="5"/>

    <menuitem id="menu_project_manage_projects" name="Projects"
              parent="menu_project_manage_root" action="action_project_manage"
              groups="project_manage.group_project_manage_consultant" sequence="10"/>

    <record id="menu_project_manage_projects" model="ir.ui.menu">
        <field name="action" ref="project_manage.action_project_manage"/>
    </record>

    <menuitem id="menu_project_manage_calendar" name="Calendar"
              parent="menu_project_manage_root" action="action_project_manage_calendar_dashboard"
              groups="project_manage.group_project_manage_consultant" sequence="11"/>

    <menuitem id="menu_project_manage_reviews" name="Customer Reviews"
              parent="menu_project_manage_root" action="action_project_manage_review"
              groups="project_manage.group_project_manage_team_lead" sequence="12"/>

    <menuitem id="menu_project_manage_approvals" name="Approval Requests"
              parent="menu_project_manage_root" action="action_project_manage_approvals"
              groups="project_manage.group_project_manage_team_lead" sequence="15"/>

    <!-- Scopes Dropdown Menu (Accessible ONLY to Project Manager and above; Hidden for Team Lead & Consultant) -->
    <menuitem id="menu_project_manage_scopes_menu" name="Scopes"
              parent="menu_project_manage_root"
              groups="project_manage.group_project_manage_manager,-project_manage.group_project_manage_team_lead,-project_manage.group_project_manage_consultant" sequence="20"/>

    <menuitem id="menu_project_manage_scopes_calendar" name="Tasks Calendar"
              parent="menu_project_manage_scopes_menu" action="action_project_manage_calendar_dashboard"
              groups="project_manage.group_project_manage_manager,-project_manage.group_project_manage_team_lead,-project_manage.group_project_manage_consultant" sequence="5"/>

    <menuitem id="menu_project_manage_scopes" name="Scopes"
              parent="menu_project_manage_scopes_menu" action="action_project_manage_scope"
              groups="project_manage.group_project_manage_manager,-project_manage.group_project_manage_team_lead,-project_manage.group_project_manage_consultant" sequence="10"/>

    <menuitem id="menu_project_manage_documentation" name="Documentation Tasks"
              parent="menu_project_manage_scopes_menu" action="action_project_manage_documentation"
              groups="project_manage.group_project_manage_manager,-project_manage.group_project_manage_team_lead,-project_manage.group_project_manage_consultant" sequence="20"/>

    <menuitem id="menu_project_manage_implementation" name="Implementation Tasks"
              parent="menu_project_manage_scopes_menu" action="action_project_manage_implementation"
              groups="project_manage.group_project_manage_manager,-project_manage.group_project_manage_team_lead,-project_manage.group_project_manage_consultant" sequence="30"/>

    <!-- Explicit Many2Many record overwrite to guarantee removal of old groups on upgrade -->
    <record id="menu_project_manage_scopes_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('project_manage.group_project_manage_manager')])]"/>
    </record>
    <record id="menu_project_manage_scopes_calendar" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('project_manage.group_project_manage_manager')])]"/>
    </record>
    <record id="menu_project_manage_scopes" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('project_manage.group_project_manage_manager')])]"/>
    </record>
    <record id="menu_project_manage_documentation" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('project_manage.group_project_manage_manager')])]"/>
    </record>
    <record id="menu_project_manage_implementation" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('project_manage.group_project_manage_manager')])]"/>
    </record>

    <!-- Configuration Menu -->
    <menuitem id="menu_project_manage_config" name="Configuration"
              parent="menu_project_manage_root"
              groups="project_manage.group_project_manage_manager" sequence="99"/>

    <menuitem id="menu_project_config_documentation" name="Documentation"
              parent="menu_project_manage_config" action="action_project_manage_config_documentation" sequence="10"/>

    <menuitem id="menu_project_manage_teams" name="Project Teams"
              parent="menu_project_manage_config" action="action_project_manage_team"
              groups="project_manage.group_project_manage_manager" sequence="15"/>

    <menuitem id="menu_project_config_scopes" name="Scopes"
              parent="menu_project_manage_config" action="action_project_manage_scope" sequence="20"/>

    <menuitem id="menu_project_config_import" name="Import Scopes (Excel/CSV)"
              parent="menu_project_manage_config" action="action_project_scope_import_wizard" sequence="30"/>

    <menuitem id="menu_project_manage_tags" name="Tags"
              parent="menu_project_manage_config" action="action_project_manage_tag" sequence="40"/>

    <menuitem id="menu_project_manage_users" name="Manage Users &amp; Privileges"
              parent="menu_project_manage_config" action="base.action_res_users"
              groups="project_manage.group_project_manage_administrator" sequence="90"/>
</odoo>
